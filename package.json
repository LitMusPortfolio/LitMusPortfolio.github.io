{
  "name": "litmus9.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "knip": {
    "entry": [
      "src/app/**/*.tsx",
      "postcss.config.mjs",
      "next.config.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "src/components/ui/**"
    ],
    "ignoreDependencies": [
      "postcss",
      "tailwindcss"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "knip": "^5.59.1",
    "lefthook": "^1.11.13",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3"
  }
}
